<configuration>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSX} %-5level [%thread] %logger{36} traceId=%X{traceId:-} spanId=%X{spanId:-} - %msg%n"/>

    <!--
        Read loki.url from Spring's environment so the profile can control it:
          - local profile   → application-local.yml  → http://localhost:3100  (port-mapped Docker)
          - Docker / prod   → application.yml + LOKI_URL env-var → http://loki:3100 (container network)
    -->
    <springProperty name="LOKI_PUSH_URL" source="loki.url" defaultValue="http://localhost:3100"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!--
        loki4j appender: pushes log records directly to Loki via HTTP POST.
        Labels use service_name so the LogQL query {service_name="car-reselling-api"} works.
    -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${LOKI_URL}/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>service_name=car-reselling-api,level=%level,host=${HOSTNAME:-localhost}</pattern>
            </label>
            <message>
                <pattern>${LOG_PATTERN}</pattern>
            </message>
            <sortByTime>true</sortByTime>
        </format>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>
</configuration>
