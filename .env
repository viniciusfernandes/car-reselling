# =============================================================================
# car-reselling – unified environment file (PROD)
#
# Used by:
#   - docker compose YAML interpolation (${VAR})
#   - (optionally) env_file: for containers (if you choose to load everything)
#
# IMPORTANT:
#   - NEVER commit real secrets. Add `.env` to .gitignore.
#   - Prefer Docker Secrets / AWS SSM / Secrets Manager for passwords in real prod.
# =============================================================================


# -----------------------------------------------------------------------------
# Docker Hub / Image tags (Compose interpolation)
# -----------------------------------------------------------------------------
DOCKERHUB_USERNAME=change-me

# Version tags produced by Jenkins (VERSION param or BUILD_NUMBER-gitSha)
API_VERSION=1
UI_VERSION=1
# NOTE: if the Jenkins-built authentication-api image crashes with
# "Unable to access jarfile app.jar", the image was built before
# `./gradlew bootJar` ran in the pipeline. Rebuild and push a corrected image,
# or point to a locally working tag (e.g. AUTH_VERSION=latest) for testing.
AUTH_VERSION=1


# -----------------------------------------------------------------------------
# Database – MySQL (shared)
# -----------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Main app DB
MYSQL_DATABASE=car_reselling
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me

# Root password (used by auth service if it connects as root, and/or mysql container)
MYSQL_ROOT_PASSWORD=change-me-root


# -----------------------------------------------------------------------------
# Main backend – car-reselling-api (Spring Boot)
# -----------------------------------------------------------------------------
SERVER_PORT=8080

# .env files are parsed LITERALLY – ${...} expressions are NOT expanded here.
# Write the full JDBC URL and credentials as plain values.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/car_reselling?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=change-me
SPRING_DATASOURCE_PASSWORD=change-me

# File storage – absolute path inside the container
STORAGE_BASE_PATH=/storage


# -----------------------------------------------------------------------------
# Authentication service connection used by the backend
# -----------------------------------------------------------------------------
AUTH_BASE_URL=http://authentication-api:8081
ORS_ALLOWED_ORIGIN_PATTERNS=https://carreselling.vps7659.panel.icontainer.run

# JWT signing secret (min 32 characters for HS256)
JWT_SECRET=change-me-to-a-long-random-secret-string-at-least-32-chars


# -----------------------------------------------------------------------------
# Auth email + OAuth2 (leave blank to disable)
# -----------------------------------------------------------------------------
MAIL_USERNAME=
MAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

FRONTEND_URL=http://localhost


# -----------------------------------------------------------------------------
# Observability – OpenTelemetry traces & metrics (backend)
# -----------------------------------------------------------------------------
OBSERVABILITY_TRACING_ENABLED=true
OBSERVABILITY_SERVICE_NAME=car-reselling-api
OBSERVABILITY_OTLP_ENDPOINT=http://otel-collector:4317
OBSERVABILITY_OTLP_HEADERS=
OBSERVABILITY_METRICS_INTERVAL=30s

OTLP_METRICS_ENABLED=true
OTLP_METRICS_URL=http://otel-collector:4318/v1/metrics
OTLP_METRICS_STEP=30s

LOKI_URL=http://loki:3100